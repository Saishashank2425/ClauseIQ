APP_NAME=ClauseIQ
APP_ENV=development
DEBUG=false
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/clauseiq
CLAUSEIQ_DENSE_MODEL=
CLAUSEIQ_CROSS_ENCODER_MODEL=
CLAUSEIQ_CLASSIFIER_BACKEND=classical
CLAUSEIQ_LEGALBERT_PATH=artifacts/legalbert-clause-classifier

# Free-tier LLM provider order. Only providers with keys are contacted.
CLAUSEIQ_LLM_PROVIDER_ORDER=groq,gemini,cerebras
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=
CLAUSEIQ_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
CLAUSEIQ_LLM_MODEL=
CLAUSEIQ_LLM_API_KEY=
# Optional Cerebras provider; enable only if an ongoing no-cost quota is available.
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
CEREBRAS_MODEL=
CEREBRAS_API_KEY=

# Optional Langfuse cloud Hobby or self-hosted. No raw document text is traced by default.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
GOOGLE_CLIENT_ID=
